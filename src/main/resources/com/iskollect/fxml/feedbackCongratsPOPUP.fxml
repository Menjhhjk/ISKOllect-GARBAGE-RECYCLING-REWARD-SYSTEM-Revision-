<AnchorPane prefHeight="400.0" prefWidth="350.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iskollect.controller.RedemptionSuccessController">
