<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="450.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iskollect.controller.StudentActionController">
   <children>
      <Label layoutX="24.0" layoutY="20.0" text="NOW ASSISTING">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Label fx:id="studentNameLabel" layoutX="24.0" layoutY="56.0" text="Clint Andrei Commendador">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="67.0" layoutY="102.0" text="What transaction would you like to perform?">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="335.0" layoutY="23.0" text="Current Balance">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="balanceLabel" layoutX="373.0" layoutY="43.0" text="20.0 pts" textFill="#206e0b">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Button layoutX="154.0" layoutY="407.0" mnemonicParsing="false" onAction="#closePopup" prefHeight="50.0" prefWidth="141.0" styleClass="clear-button" text="Go Back">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Pane fx:id="addBottlePane" layoutX="22.0" layoutY="137.0" onMouseClicked="#openBottleSubmission" prefHeight="229.0" prefWidth="192.0" styleClass="hover-pane">
         <children>
            <Label layoutX="53.0" layoutY="194.0" text="Add Bottle">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ImageView fitHeight="200.0" fitWidth="200.0" layoutX="-4.0">
               <image>
                  <Image url="@../assets/bottle.png" />
               </image>
            </ImageView>
         </children>
      </Pane>
      <Pane fx:id="redeemPane" layoutX="239.0" layoutY="137.0" onMouseClicked="#openRewards" prefHeight="230.0" prefWidth="192.0" styleClass="hover-pane">
         <children>
            <Label layoutX="34.0" layoutY="196.0" text="Redeem Reward">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ImageView fitHeight="157.0" fitWidth="172.0" layoutX="11.0" layoutY="25.0">
               <image>
                  <Image url="@../assets/coupon.png" />
               </image>
            </ImageView>
         </children>
      </Pane>
   </children>
</AnchorPane>
