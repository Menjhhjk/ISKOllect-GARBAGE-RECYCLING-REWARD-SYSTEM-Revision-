<AnchorPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iskollect.controller.LoginController">
   <children>
      <HBox layoutX="-1.0" prefHeight="768.0" prefWidth="1366.0">
         <children>
            <ImageView fitHeight="783.0" fitWidth="892.0">
               <image>
                  <Image url="@../assets/login.jpg" />
