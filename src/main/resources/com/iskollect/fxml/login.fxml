                  </ImageView>
                  <Label layoutX="106.0" layoutY="188.0" text="Garbage Recycling Rewards System">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                  </Label>
                  <Label layoutX="159.0" layoutY="246.0" text="Tapat ko, Lin">
                     <font>
                        <Font name="Arial" size="18.0" />
                     </font>
                  </Label>
                  <Label layoutX="263.0" layoutY="246.0" text="ISKO" textFill="#841212">
