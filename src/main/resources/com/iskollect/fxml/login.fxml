            </ImageView>
            <Pane prefHeight="768.0" prefWidth="474.0" style="-fx-background-color: #bef38b;">
               <children>
                  <ImageView fitHeight="88.0" fitWidth="374.0" layoutX="50.0" layoutY="100.0">
                     <image>
               <Image preserveRatio="true" requestedHeight="88.0" requestedWidth="374.0" smooth="true" url="@../assets/bf780c16-c3ed-449f-b2ab-6ceda0ca0e53.png" />
