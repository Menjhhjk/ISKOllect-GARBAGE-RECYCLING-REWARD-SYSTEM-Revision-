<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="560.0" prefWidth="401.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iskollect.controller.EditRewardController">
   <children>
      <AnchorPane layoutX="1.0" prefHeight="560.0" prefWidth="400.0" stylesheets="@../style.css">
         <children>
            <Label layoutX="67.0" layoutY="18.0" text="Edit Coupon" textFill="#203c8b">
               <font>
                  <Font name="Arial Bold" size="30.0" />
               </font>
            </Label>
            <Label layoutX="39.0" layoutY="70.0" text="Reward Name">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label layoutX="39.0" layoutY="147.0" text="Points Cost">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <TextField fx:id="rewardNameField" layoutX="36.0" layoutY="95.0" prefHeight="42.0" prefWidth="326.0" promptText="Supplies Coupon" styleClass="searchinput-field" />
            <TextField fx:id="pointsField" layoutX="37.0" layoutY="172.0" prefHeight="42.0" prefWidth="326.0" promptText="10" styleClass="searchinput-field" />
            <Button layoutX="39.0" layoutY="485.0" mnemonicParsing="false" onAction="#clearForm" prefHeight="42.0" prefWidth="154.0" styleClass="clear-button" text="Clear" />
            <Button layoutX="210.0" layoutY="485.0" mnemonicParsing="false" onAction="#saveReward" prefHeight="42.0" prefWidth="154.0" styleClass="login-button" text="Save Changes">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button layoutX="365.0" layoutY="11.0" mnemonicParsing="false" onAction="#closePopup" styleClass="icon-button" text="X" />
            <ImageView fitHeight="42.0" fitWidth="38.0" layoutX="20.0" layoutY="11.0">
               <image>
                  <Image url="@../assets/Edit.png" />
               </image>
            </ImageView>
            <Label layoutX="38.0" layoutY="224.0" text="Description">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <TextArea fx:id="descriptionField" layoutX="37.0" layoutY="251.0" prefHeight="94.0" prefWidth="326.0" promptText="Ballpen, bondpaper (5 pcs.), pencil, eraser, correction tape, and similar items." wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </TextArea>
            <Pane layoutX="37.0" layoutY="383.0" prefHeight="80.0" prefWidth="326.0" style="-fx-background-color: #ffd664; -fx-background-radius: 10;">
               <children>
                  <Label layoutX="14.0" layoutY="9.0" text="Yes">
                     <font>
                        <Font name="Arial Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label layoutX="13.0" layoutY="35.0" prefHeight="20.0" prefWidth="301.0" text="Toggle off = unavailable based ">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label layoutX="13.0" layoutY="54.0" text="on canteen stock">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ToggleButton fx:id="availabilityToggle" layoutX="246.0" layoutY="23.0" mnemonicParsing="false" onAction="#updateAvailabilityText" prefHeight="34.0" prefWidth="61.0" text="YES" />
               </children>
            </Pane>
            <Label layoutX="40.0" layoutY="357.0" text="Availability">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
